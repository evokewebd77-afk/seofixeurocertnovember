---
import BaseLayout from '../layouts/BaseLayout.astro';

const opportunities = [
  {
    title: 'Become an associate auditor',
    description: 'Read about the associate auditor role, the experience it can involve and how to enquire about possible opportunities.',
    href: '/post/become-associate/'
  },
  {
    title: 'Benefits of becoming a Eurocert Asia associate auditor',
    description: 'Learn about the professional aspects of working as an associate auditor and the topics to discuss before applying.',
    href: '/post/benefits-associate/'
  }
];
---

<BaseLayout
  title="Careers | Eurocert Asia"
  description="Explore information about associate auditor opportunities with Eurocert Asia and contact the team to discuss current requirements."
  canonicalUrl="https://www.eurocert.asia/careers/"
>
  <main>
    <section class="bg-[#030a16] py-20 text-center text-white">
      <div class="container mx-auto px-6">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.3em] text-eurogold-400">Careers</p>
        <h1 class="text-4xl font-bold md:text-5xl">Associate auditor opportunities</h1>
        <p class="mx-auto mt-5 max-w-2xl text-white/70">
          Read about the associate auditor role and contact Eurocert Asia to discuss whether your experience may fit current needs.
          Opportunities, qualifications and locations depend on business requirements.
        </p>
      </div>
    </section>

    <section class="bg-slate-50 py-16">
      <div class="container mx-auto grid max-w-5xl gap-6 px-6 md:grid-cols-2">
        {opportunities.map((opportunity) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <h2 class="text-xl font-bold text-slate-900">{opportunity.title}</h2>
            <p class="mt-3 leading-relaxed text-slate-600">{opportunity.description}</p>
            <a class="mt-6 inline-flex font-semibold text-euro-600 hover:text-euro-800" href={opportunity.href}>
              Read the article <span aria-hidden="true" class="ml-2">&rarr;</span>
            </a>
          </article>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-5xl px-6 text-sm text-slate-500">
        These articles are informational; they do not represent a guarantee of an open vacancy or a specific engagement.
        <a class="font-semibold text-euro-600 hover:text-euro-800" href="/contact/">Contact us</a> to ask about current opportunities.
      </p>
    </section>
  </main>
</BaseLayout>
