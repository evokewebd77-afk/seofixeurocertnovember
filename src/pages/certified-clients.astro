---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Certified Clients | Eurocert Asia"
  description="Explore Eurocert Asia certified clients and verification resources for organisations assessed through Eurocert Asia certification, inspection and audit services."
  canonicalUrl="https://www.eurocert.asia/certified-clients/"
  ogImage="https://res.cloudinary.com/dwnnakrrh/image/upload/f_webp,q_auto:good,w_1600/v1782367859/eurocert/Untitled_design_19_.png.webp"
  keywords="Eurocert Asia,Eurocert Asia,ISO certification,CE marking,food safety certification,FSSC 22000,BRCGS,GFSI,social audits,Sedex,SMETA,SA8000,inspection services,certification body,India,management systems,ISO 9001,ISO 14001,ISO 45001"
  noindex
>
<style is:global>@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:900;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Brands";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-brands-400.woff2) format('woff2')}@font-face{font-family:"Font Awesome 6 Free";font-style:normal;font-weight:400;font-display:swap;src:url(https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-regular-400.woff2) format('woff2')}</style>
<section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden bg-[#030a16]"><div class="absolute inset-0 z-0"><img src="https://res.cloudinary.com/dwnnakrrh/image/upload/f_webp,q_auto:good,w_1600/v1782368140/eurocert/l1.png.webp" alt="Certified Clients" class="w-full h-full object-cover"/><div class="absolute inset-0 bg-gradient-to-t from-[#030a16] via-[#030a16]/70 to-[#030a16]/40"></div></div><div class="container mx-auto px-6 relative z-10 text-center py-20"><div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-eurogold-400/30 bg-eurogold-400/5 backdrop-blur-sm mb-6"><span class="w-1.5 h-1.5 rounded-full bg-eurogold-400 animate-pulse"></span><span class="heading-font text-[10px] text-eurogold-400 tracking-[0.3em] uppercase font-bold">Our Clients</span></div><h1 class="heading-font text-4xl sm:text-6xl md:text-7xl font-bold text-white mb-3 tracking-tight" style="text-shadow:0 0 30px rgba(212,168,67,0.3)">Certified <span class="text-eurogold-400">Clients</span></h1><div class="flex items-center justify-center gap-2 text-white/80 text-sm heading-font mt-4"><span class="text-white/70">Certified Clients</span></div></div></section><section class="py-14 lg:py-18 bg-white">
  <div class="container mx-auto px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <h4 class="heading-font text-[11px] text-euro-600 tracking-[0.5em] uppercase mb-2 font-bold">Trusted Partners</h4>
        <h2 class="heading-font text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Organisations We've Certified</h2>
        <p class="text-slate-400 text-sm mt-3 max-w-2xl mx-auto">Eurocert Asia has certified {SITE.metrics.clientsCertified} clients across {SITE.metrics.continentsServed} continents, spanning diverse industries and sectors.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 mb-10">
        <div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">{SITE.metrics.clientsCertified}</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Clients Certified</span></div>
        <div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">{SITE.metrics.continentsServed}</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Continents</span></div>
        <div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">{SITE.metrics.certificationTypes}</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Certification Types</span></div>
        <div class="p-6 rounded-2xl border border-slate-100 bg-[#f8fafc] text-center"><span class="heading-font text-2xl md:text-3xl font-bold text-euro-600 block mb-1">{SITE.metrics.yearsExperience}</span><span class="text-slate-400 text-[10px] uppercase tracking-[0.2em] heading-font font-bold">Years Experience</span></div>
      </div>
      <div class="mb-10">
        <h3 class="heading-font text-xl md:text-2xl font-bold text-slate-900 mb-4">Verify a Certificate</h3>
        <div class="p-8 rounded-2xl border border-euro-100 bg-euro-50/30">
          <p class="text-slate-500 text-sm leading-relaxed mb-6">The public client register is being updated. To verify a certificate, enter the certificate number and company name below. Our team will confirm the certificate status, scope and expiry date.</p>
          <form id="verify-certificate-form" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="certificate-number" class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-2">Certificate Number</label>
              <input id="certificate-number" name="certificate" type="text" required placeholder="e.g. IN-ISO-9001-0001" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-euro-600 focus:outline-none" />
            </div>
            <div>
              <label for="company-name" class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-2">Company Name</label>
              <input id="company-name" name="company" type="text" required placeholder="Your company" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:border-euro-600 focus:outline-none" />
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="inline-flex items-center justify-center gap-2 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-white bg-euro-600 rounded-full px-8 py-3.5 hover:bg-euro-700 transition-all shadow-lg">Request Verification <i class="fas fa-arrow-right text-[9px]"></i></button>
            </div>
          </form>
          <p class="text-slate-400 text-xs mt-4">Prefer to contact us directly? Email <a href="mailto:info@eurocert.in" class="text-euro-600 hover:underline">info@Eurocert Asia.in</a>.</p>
        </div>
      </div>
      <div class="p-8 rounded-2xl border border-euro-100 bg-euro-50/30 text-center">
        <div class="w-14 h-14 rounded-2xl bg-euro-600 flex items-center justify-center mx-auto mb-4"><i class="fas fa-certificate text-white text-xl"></i></div>
        <h3 class="heading-font text-lg font-bold text-slate-900 mb-2">Accreditation &amp; Registry Information</h3>
        <p class="text-slate-400 text-sm max-w-lg mx-auto mb-6">Review the accreditations held by Eurocert Asia. and the verification routes available for certificates issued through our offices.</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a class="inline-flex items-center justify-center gap-2 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-white bg-euro-600 rounded-full px-8 py-3.5 hover:bg-euro-700 transition-all shadow-lg" href="/accreditations/">View Accreditation Registry <i class="fas fa-arrow-right text-[9px]"></i></a>
          <a class="inline-flex items-center justify-center gap-2 heading-font text-[11px] font-bold uppercase tracking-[0.2em] text-euro-600 bg-white border border-euro-200 rounded-full px-8 py-3.5 hover:bg-euro-50 transition-all" href="/contact/">Contact the Team</a>
        </div>
      </div>
    </div>
  </div>
</section>
<script define:vars={{ email: SITE.contact.email }}>
  document.getElementById('verify-certificate-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const certificate = form.certificate.value.trim();
    const company = form.company.value.trim();
    const subject = encodeURIComponent(`Certificate verification request: ${certificate}`);
    const body = encodeURIComponent(`Certificate number: ${certificate}\nCompany: ${company}\n\nPlease verify this certificate.`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script></BaseLayout>
